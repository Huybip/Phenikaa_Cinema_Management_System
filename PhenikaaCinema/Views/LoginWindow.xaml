<Window x:Class="PhenikaaCinema.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PHENIKAA CINEMA | Đăng nhập hệ thống"
        Height="660"
        Width="1020"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BgMain}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT BRAND PANEL (Modern Deep Blue) -->
        <Border Grid.Column="0" Background="{StaticResource DarkBlue}" ClipToBounds="True">
            <Grid Margin="48,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BRAND HEADER -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="10" Width="48" Height="48" Margin="0,0,12,0" Padding="4">
                        <Image Source="/Assets/phenikaa_logo.png" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PHENIKAA CINEMA" FontSize="20" FontWeight="ExtraBold" Foreground="White"/>
                        <TextBlock Text="HỆ THỐNG ĐẶT VÉ TRỰC TUYẾN" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD"/>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER BRAND PROMO -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20,0,20">
                    <TextBlock Text="Trải Nghiệm Điện Ảnh&#10;Đẳng Cấp &amp; Hiện Đại"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"
                               LineHeight="42"/>

                    <Border Background="{StaticResource AccentOrange}" Width="60" Height="4" CornerRadius="2" HorizontalAlignment="Left" Margin="0,18,0,18"/>

                    <TextBlock Text="Đặt vé nhanh chóng, chọn ghế 2D/3D trực quan, thanh toán an toàn và tận hưởng những thước phim bom tấn đỉnh cao."
                               Foreground="#DBEAFE"
                               FontSize="14"
                               TextWrapping="Wrap"
                               LineHeight="22"/>

                    <!-- FEATURE BULLETS -->
                    <Border Background="#173591" CornerRadius="12" Padding="16,14" Margin="0,24,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="✓" Foreground="{StaticResource AccentOrange}" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="Sơ đồ ghế 2D/3D tương tác theo thời gian thực" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="✓" Foreground="{StaticResource AccentOrange}" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="Cập nhật lịch chiếu và khuyến mãi liên tục" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" Foreground="{StaticResource AccentOrange}" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="Vé điện tử QR tiện lợi, vào rạp không chờ đợi" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="© 2026 PHENIKAA CINEMA • ALL RIGHTS RESERVED" Foreground="#93C5FD" FontSize="11"/>
            </Grid>
        </Border>

        <!-- RIGHT LOGIN FORM -->
        <Grid Grid.Column="1" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="48,40" VerticalAlignment="Center">

                    <TextBlock Text="Chào mừng trở lại!"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"/>

                    <TextBlock Text="Đăng nhập vào tài khoản PHENIKAA CINEMA"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,6,0,28"/>

                    <!-- EMAIL INPUT -->
                    <TextBlock Text="ĐỊA CHỈ EMAIL"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="EmailTextBox"
                             Style="{StaticResource InputBox}"
                             ToolTip="Nhập địa chỉ email của bạn"
                             MaxLength="254"
                             Margin="0,0,0,18"/>

                    <!-- PASSWORD INPUT -->
                    <TextBlock Text="MẬT KHẨU"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"
                               Margin="0,0,0,8"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Style="{StaticResource InputPassword}"
                                 ToolTip="Nhập mật khẩu của bạn"
                                 Margin="0,0,0,10"/>

                    <!-- ERROR MESSAGE -->
                    <TextBlock x:Name="ErrorTextBlock"
                               Text=""
                               Foreground="{StaticResource Error}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>

                    <!-- LOGIN BUTTON -->
                    <Button x:Name="LoginSubmitButton"
                            Content="ĐĂNG NHẬP"
                            Style="{StaticResource PrimaryButton}"
                            Height="44"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="LoginButton_Click"/>

                    <!-- REGISTER LINK BUTTON -->
                    <Button Content="Chưa có tài khoản? Đăng ký ngay"
                            Style="{StaticResource AccentButton}"
                            Height="42"
                            Margin="0,12,0,0"
                            Click="btnOpenRegister_Click"/>

                    <!-- BACK BUTTON -->
                    <Button Content="Quay lại trang chủ"
                            Style="{StaticResource GhostButton}"
                            Height="38"
                            Margin="0,8,0,0"
                            Click="BackToHomeButton_Click"/>

                    <!-- INFO FOOTER -->
                    <Border Background="{StaticResource BgMain}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="BẢO MẬT HỆ THỐNG"
                                       Foreground="{StaticResource PrimaryBlue}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Thông tin đăng nhập được mã hóa an toàn. Vui lòng không chia sẻ mật khẩu cho bất kỳ ai."
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
