<UserControl x:Class="PhenikaaCinema.Views.Graphics.CinemaRoom3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#0A0F1D"
             FontFamily="Segoe UI">

    <Grid>
        <!-- 3D VIEWPORT -->
        <Viewport3D x:Name="CinemaViewport" 
                    MouseDown="Viewport_MouseDown" 
                    MouseMove="Viewport_MouseMove" 
                    MouseUp="Viewport_MouseUp" 
                    MouseWheel="Viewport_MouseWheel"
                    Cursor="SizeAll">

            <!-- PERSPECTIVE CAMERA -->
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="MainCamera" 
                                   Position="0, 7.5, 15.5" 
                                   LookDirection="0, -0.38, -1" 
                                   UpDirection="0, 1, 0" 
                                   FieldOfView="62"/>
            </Viewport3D.Camera>

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup x:Name="WorldModelGroup">
                        <!-- LIGHTING -->
                        <AmbientLight Color="#404855"/>
                        <DirectionalLight Color="#FFFFFF" Direction="-0.3, -1, -0.6"/>
                        <!-- Screen projector beam light from rear to screen -->
                        <DirectionalLight Color="#FF2563EB" Direction="0, -0.15, -1"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>

        <!-- 3D CONTROLS OVERLAY (White Card) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                Background="#EEFFFFFF" CornerRadius="10" Padding="14,12" Margin="16"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                Effect="{StaticResource CardShadow}">
            <StackPanel>
                <TextBlock Text="🎮  ĐIỀU KHIỂN GÓC NHÌN 3D" Foreground="{StaticResource PrimaryBlue}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="• Giữ chuột trái &amp; rê: Xoay góc nhìn" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock Text="• Lăn con trỏ chuột: Thu phóng (Zoom)" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="🎥 Góc chuẩn" Background="{StaticResource LightBlue}" Foreground="{StaticResource PrimaryBlue}" BorderThickness="0" 
                            Padding="10,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="BtnResetCamera_Click" Margin="0,0,6,0"/>
                    <Button Content="🎬 Góc màn chiếu" Background="{StaticResource LightBlue}" Foreground="{StaticResource PrimaryBlue}" BorderThickness="0" 
                            Padding="10,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="BtnScreenView_Click" Margin="0,0,6,0"/>
                    <Button Content="💺 Góc khán giả" Background="{StaticResource LightBlue}" Foreground="{StaticResource PrimaryBlue}" BorderThickness="0" 
                            Padding="10,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="BtnSeatView_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 3D ROOM INFO BADGE -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                Background="#EEFFFFFF" CornerRadius="8" Padding="14,8" Margin="16"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                Effect="{StaticResource CardShadow}">
            <StackPanel Orientation="Horizontal">
                <Border Width="10" Height="10" Background="{StaticResource PrimaryBlue}" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="RoomInfoText" Text="Mô phỏng không gian 3D phòng chiếu thực tế" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
