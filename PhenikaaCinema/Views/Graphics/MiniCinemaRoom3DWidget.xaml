<UserControl x:Class="PhenikaaCinema.Views.Graphics.MiniCinemaRoom3DWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="450"
             Background="Transparent">

    <Grid>
        <!-- 3D Mini Viewport with continuous smooth rotation -->
        <Viewport3D x:Name="MiniViewport">
            <Viewport3D.Camera>
                <PerspectiveCamera Position="0, 8.5, 12.0" LookDirection="0, -0.65, -1" UpDirection="0, 1, 0" FieldOfView="55"/>
            </Viewport3D.Camera>

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup x:Name="MiniSceneGroup">
                        <AmbientLight Color="#505060"/>
                        <DirectionalLight Color="#FFFFFF" Direction="-0.2, -1, -0.5"/>
                        <DirectionalLight Color="#2563EB" Direction="0, -0.2, -1"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>

                <!-- Smooth 3D Rotating Animation -->
                <ModelVisual3D.Transform>
                    <RotateTransform3D>
                        <RotateTransform3D.Rotation>
                            <AxisAngleRotation3D x:Name="RoomTurntableRotation" Axis="0,1,0" Angle="0"/>
                        </RotateTransform3D.Rotation>
                    </RotateTransform3D>
                </ModelVisual3D.Transform>
            </ModelVisual3D>
        </Viewport3D>

        <!-- Overlay Tag -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                Background="#C8171722" CornerRadius="6" Padding="10,6" Margin="12"
                BorderBrush="#2C2C3E" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBlue}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="MÔ HÌNH RẠP CHIẾU 3D TRỰC QUAN" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

