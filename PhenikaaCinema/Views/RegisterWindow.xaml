<Window x:Class="PhenikaaCinema.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng ký tài khoản - PHENIKAA CINEMA"
        Width="1020" Height="720"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT BRAND PANEL (Modern Deep Blue) -->
        <Border Grid.Column="0" Background="{StaticResource DarkBlue}" ClipToBounds="True">
            <Grid Margin="48,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Background="White" CornerRadius="10" Width="48" Height="48" Margin="0,0,12,0" Padding="4">
                        <Image Source="/Assets/phenikaa_emblem.png" Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PHENIKAA CINEMA" FontSize="20" FontWeight="ExtraBold" Foreground="White"/>
                        <TextBlock Text="TẠO TÀI KHOẢN KHÁCH HÀNG" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20,0,20">
                    <TextBlock Text="Thế Giới Điện Ảnh&#10;Đang Chờ Đón Bạn!"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"
                               LineHeight="42"/>

                    <Border Background="{StaticResource AccentOrange}" Width="60" Height="4" CornerRadius="2" HorizontalAlignment="Left" Margin="0,18,0,18"/>

                    <TextBlock Text="Đăng ký tài khoản miễn phí để nhận ưu đãi vé xem phim, tích điểm thành viên và quản lý lịch sử đặt vé dễ dàng."
                               Foreground="#DBEAFE"
                               FontSize="14"
                               TextWrapping="Wrap"
                               LineHeight="22"/>

                    <Border Background="#173591" CornerRadius="12" Padding="16,14" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="ĐẶC QUYỀN THÀNH VIÊN" Foreground="{StaticResource AccentOrange}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="Ưu đãi vé xem phim &amp; Combo bắp nước hấp dẫn" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <TextBlock Text="Theo dõi lịch chiếu, nhận mã giảm giá và quản lý vé điện tử." Foreground="#BFDBFE" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="PHENIKAA CINEMA • YOUR MOVIE JOURNEY" Foreground="#93C5FD" FontSize="11"/>
            </Grid>
        </Border>

        <!-- RIGHT REGISTRATION FORM -->
        <Grid Grid.Column="1" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="48,36" VerticalAlignment="Center">

                    <TextBlock Text="Tạo tài khoản mới"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"/>

                    <TextBlock Text="Điền thông tin để đăng ký thành viên rạp chiếu"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,6,0,24"/>

                    <TextBlock Text="HỌ VÀ TÊN" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtFullName" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="EMAIL" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtEmail" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="SỐ ĐIỆN THOẠI (TÙY CHỌN)" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtPhone" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="MẬT KHẨU" Style="{StaticResource FormLabel}"/>
                    <PasswordBox x:Name="txtPassword" Style="{StaticResource InputPassword}" Margin="0,0,0,14"/>

                    <TextBlock Text="XÁC NHẬN MẬT KHẨU" Style="{StaticResource FormLabel}"/>
                    <PasswordBox x:Name="txtConfirmPassword" Style="{StaticResource InputPassword}" Margin="0,0,0,20"/>

                    <Button x:Name="btnRegister"
                            Content="TẠO TÀI KHOẢN NGAY"
                            Style="{StaticResource PrimaryButton}"
                            Height="44"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="btnRegister_Click"/>

                    <Button x:Name="btnBackToLogin"
                            Content="Đã có tài khoản? Quay lại đăng nhập"
                            Style="{StaticResource AccentButton}"
                            Height="42"
                            Margin="0,12,0,0"
                            Click="btnBackToLogin_Click"/>

                    <TextBlock Text="Bằng việc đăng ký, bạn đồng ý với các điều khoản dịch vụ của PHENIKAA CINEMA."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,18,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
