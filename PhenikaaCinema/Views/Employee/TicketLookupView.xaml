<UserControl x:Class="PhenikaaCinema.Views.Employee.TicketLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="#F4F8FC">

    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1769AA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenButton" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#124B7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,10"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#15324B"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF4FC"/>
                    <Setter Property="Foreground" Value="#124B7A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,18" BorderBrush="#E1EAF2" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="TRA CỨU &amp; SOÁT VÉ ĐIỆN TỬ" FontSize="22" FontWeight="ExtraBold" Foreground="#15324B"/>
                <TextBlock Text="Nhân viên soát vé tại cổng: tra cứu theo mã vé, kiểm tra hợp lệ và đánh dấu đã soát" 
                           FontSize="13" Foreground="#63778A" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- TRA CỨU NHANH THEO MÃ VÉ -->
        <Border Grid.Row="1" Background="#124B7A" CornerRadius="12" Padding="20" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="🎟 SOÁT VÉ NHANH" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                    <TextBox x:Name="QuickScanBox" Height="40" VerticalContentAlignment="Center" Padding="12,0"
                             FontSize="15" FontWeight="Bold" 
                             KeyDown="QuickScanBox_KeyDown"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🔍 Tra cứu" Style="{StaticResource ActionButton}" 
                        Background="#1769AA" Margin="12,28,10,0" Click="BtnQuickSearch_Click"/>
                <Button Grid.Column="2" Content="✅ Soát vé ngay" Style="{StaticResource GreenButton}" 
                        Margin="0,28,0,0" Click="BtnCheckIn_Click"/>
            </Grid>
        </Border>

        <!-- KẾT QUẢ SOÁT VÉ NHANH -->
        <Border x:Name="QuickResultBanner" Grid.Row="2" CornerRadius="10" Padding="16" Margin="0,0,0,18" Visibility="Collapsed" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="QuickResultIcon" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="QuickResultTitle" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="QuickResultDetail" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BỘ LỌC + BẢNG DANH SÁCH VÉ -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BỘ LỌC -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#E1EAF2" BorderThickness="1">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="🔍 Tìm theo mã vé / phim:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#15324B" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Width="240" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                 TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Trạng thái:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#15324B" Margin="0,0,8,0"/>
                        <ComboBox x:Name="StatusFilterComboBox" Width="160" Height="34" VerticalContentAlignment="Center" SelectionChanged="StatusFilterComboBox_SelectionChanged">
                            <ComboBoxItem Content="Tất cả vé" IsSelected="True"/>
                            <ComboBoxItem Content="Hợp lệ (Chưa soát)"/>
                            <ComboBoxItem Content="Đã soát vé"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Content="🔄 Tải lại" Style="{StaticResource ActionButton}" Click="BtnRefresh_Click" Margin="0,0,0,0"/>
                    <TextBlock x:Name="TicketCountText" Text="0 vé" VerticalAlignment="Center" Foreground="#1769AA" FontWeight="Bold" Margin="14,0,0,0"/>
                </WrapPanel>
            </Border>

            <!-- BẢNG VÉ -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E1EAF2" BorderThickness="1" ClipToBounds="True">
                <DataGrid x:Name="TicketsDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDF2F7"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MÃ VÉ" Binding="{Binding TicketCode}" Width="130" FontWeight="Bold"/>
                        <DataGridTextColumn Header="TÊN PHIM" Binding="{Binding MovieTitle}" Width="*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="PHÒNG" Binding="{Binding RoomName}" Width="100"/>
                        <DataGridTextColumn Header="GHẾ" Binding="{Binding SeatCode}" Width="70"/>
                        <DataGridTextColumn Header="LOẠI GHẾ" Binding="{Binding SeatType}" Width="90"/>
                        <DataGridTextColumn Header="SUẤT CHIẾU" Binding="{Binding FormattedShowtime}" Width="130"/>
                        <DataGridTextColumn Header="GIÁ VÉ" Binding="{Binding FormattedPrice}" Width="100" FontWeight="Bold"/>
                        <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusText}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- HÀNH ĐỘNG DƯỚI -->
        <Border Grid.Row="4" Background="White" CornerRadius="12" Padding="16" Margin="0,18,0,0" BorderBrush="#E1EAF2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectedTicketInfoText" Text="Chọn vé trong bảng để soát" 
                           Foreground="#63778A" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <WrapPanel Grid.Column="1">
                    <Button x:Name="BtnCheckInSelected" Content="✅ Soát vé đã chọn" Style="{StaticResource GreenButton}" 
                            Click="BtnCheckInSelected_Click" Margin="0,0,10,0" IsEnabled="False"/>
                    <Button x:Name="BtnViewDetail" Content="🔍 Xem chi tiết" Style="{StaticResource ActionButton}" 
                            Click="BtnViewDetail_Click" IsEnabled="False"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

