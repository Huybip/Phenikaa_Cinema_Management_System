<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PhenikaaCinema.Views.Employee.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PHENIKAA CINEMA | Cổng nhân viên quầy vé"
        Height="840" Width="1300"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="NavTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveNavTabButton" TargetType="Button" BasedOn="{StaticResource NavTabButton}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP NAVIGATION BAR (White Modern Header) -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Effect="{StaticResource CardShadow}">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LOGO -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="8" Width="38" Height="38" Margin="0,0,10,0" Padding="3" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                        <Image Source="/Assets/phenikaa_emblem.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="PHENIKAA" Foreground="{StaticResource PrimaryBlue}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    <TextBlock Text=" STAFF" Foreground="{StaticResource AccentOrange}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                </StackPanel>

                <!-- NAVIGATION TABS -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="40,0,0,0">
                    <Button x:Name="BtnNavSell" Style="{StaticResource ActiveNavTabButton}" Click="BtnNavSell_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Bán vé tại quầy" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnNavBookings" Style="{StaticResource NavTabButton}" Click="BtnNavBookings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Tra cứu đơn hàng" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnNavTickets" Style="{StaticResource NavTabButton}" Click="BtnNavTickets_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE773;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Soát vé vào rạp" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnNavShowtimes" Style="{StaticResource NavTabButton}" Click="BtnNavShowtimes_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Lịch chiếu rạp" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- USER INFO & LOGOUT -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource LightBlue}" CornerRadius="18" Padding="12,6" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource DarkBlue}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="EmployeeNameText"
                                       Text="Nhân viên quầy"
                                       Foreground="{StaticResource DarkBlue}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Đăng xuất"
                            Style="{StaticResource DangerButton}"
                            Height="36"
                            Padding="14,0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN VIEW HOST -->
        <ContentControl Grid.Row="1" x:Name="MainContentControl" Background="{StaticResource BgMain}"/>
    </Grid>
</Window>
