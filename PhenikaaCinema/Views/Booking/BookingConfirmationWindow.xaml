<Window x:Class="PhenikaaCinema.Views.Booking.BookingConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận đơn đặt vé - PHENIKAA CINEMA" Height="700" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="28,0" Effect="{StaticResource CardShadow}">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PHENIKAA" Foreground="{StaticResource PrimaryBlue}" FontSize="20" FontWeight="Black" Margin="0,0,6,0"/>
                    <TextBlock Text="CINEMA" Foreground="{StaticResource AccentOrange}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text=" / Xác nhận đơn đặt vé" Foreground="{StaticResource TextSecondary}" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- COUNTDOWN TIMER -->
                <Border HorizontalAlignment="Right" Background="{StaticResource LightOrange}" BorderBrush="{StaticResource AccentOrange}" BorderThickness="1" CornerRadius="20" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏳ Giữ ghế còn: " Foreground="{StaticResource AccentOrange}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CountdownTimerText" Text="10:00" Foreground="{StaticResource AccentOrange}" FontSize="15" FontWeight="ExtraBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN DETAILS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,24">
            <StackPanel>

                <!-- TOP CARD: BOOKING CODE & STATUS -->
                <Border Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,18" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MÃ ĐƠN GIỮ CHỖ TẠM THỜI" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="BookingCodeText" Text="BK202610280001" Foreground="{StaticResource PrimaryBlue}" FontSize="20" FontWeight="ExtraBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource LightOrange}" CornerRadius="6" Padding="10,4">
                            <TextBlock x:Name="StatusBadgeText" Text="ĐANG GIỮ CHỖ (10 PHÚT)" Foreground="{StaticResource AccentOrange}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- MOVIE & SHOWTIME INFO CARD -->
                <Border Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,18" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: MOVIE -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="THÔNG TIN PHIM" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="MovieTitleText" Text="Tên phim" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="MovieDetailText" Text="120 phút • Thể loại" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        </StackPanel>

                        <!-- RIGHT: SHOWTIME & ROOM -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SUẤT CHIẾU &amp; PHÒNG" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="ShowtimeText" Text="18:00 - 20:00 (29/10/2026)" Foreground="{StaticResource PrimaryBlue}" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="RoomNameText" Text="Phòng chiếu số 1" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SEAT LIST TABLE -->
                <Border Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,18" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="DANH SÁCH GHẾ ĐÃ GIỮ" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="SeatsItemsControl">
                            <!-- Dynamic seat rows -->
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- PROMOTION BOX -->
                <Border Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,18" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="MÃ KHUYẾN MÃI / GIẢM GIÁ" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="PromoCodeInput" Style="{StaticResource InputBox}" Height="38"/>
                            <TextBlock x:Name="PromoMessageText" Foreground="{StaticResource Success}" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Height="38" Content="Áp dụng mã" 
                                Style="{StaticResource SecondaryButton}" Padding="18,0" Click="ApplyPromo_Click"/>
                    </Grid>
                </Border>

                <!-- PRICE SUMMARY -->
                <Border Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="20" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Tạm tính vé xem phim:" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                            <TextBlock x:Name="SubtotalText" Text="0 đ" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Giảm giá khuyến mãi:" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                            <TextBlock x:Name="DiscountText" Text="- 0 đ" Foreground="{StaticResource Success}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,0,0,12"/>
                        <Grid>
                            <TextBlock Text="TỔNG TIỀN THANH TOÁN:" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FinalTotalText" Text="0 đ" Foreground="{StaticResource AccentOrange}" FontSize="24" FontWeight="ExtraBold" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER ACTIONS -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="32,14" Effect="{StaticResource CardShadow}">
            <Grid VerticalAlignment="Center">
                <Button Content="✕  Hủy đơn đặt vé" Style="{StaticResource DangerButton}" Height="42" HorizontalAlignment="Left" Click="CancelBooking_Click"/>
                <Button x:Name="PayNowButton" Content="TIẾN HÀNH THANH TOÁN →" Style="{StaticResource AccentButton}" Height="42" Padding="30,0" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Click="PayNow_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
