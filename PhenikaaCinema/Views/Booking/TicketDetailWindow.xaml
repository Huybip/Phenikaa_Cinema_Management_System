<Window x:Class="PhenikaaCinema.Views.Booking.TicketDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vé xem phim điện tử - PHENIKAA CINEMA" Height="720" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="28,0" Effect="{StaticResource CardShadow}">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PHENIKAA" Foreground="{StaticResource PrimaryBlue}" FontSize="20" FontWeight="Black" Margin="0,0,6,0"/>
                    <TextBlock Text="CINEMA" Foreground="{StaticResource AccentOrange}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text=" / Vé xem phim điện tử" Foreground="{StaticResource TextSecondary}" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <Button Content="✕  Đóng" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Height="36" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <!-- TICKETS SCROLLVIEWER -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,24">
            <StackPanel x:Name="TicketsContainer">
                <TextBlock x:Name="StatusMessageText" Text="Đang tải danh sách vé..." Foreground="{StaticResource TextSecondary}" FontSize="14" HorizontalAlignment="Center" Margin="0,40,0,0"/>
                <!-- Dynamic Cinema Ticket Cards -->
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER ACTIONS -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="32,0" Effect="{StaticResource CardShadow}">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="* Vui lòng xuất trình mã vé tại quầy soát vé rạp phim trước giờ chiếu 10 phút." Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🧾  In hóa đơn" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,0" Click="PrintInvoice_Click"/>
                    <Button Content="🖨  In vé xem phim" Style="{StaticResource PrimaryButton}" Height="38" Margin="0,0,14,0" Click="PrintTickets_Click"/>
                    <Button Content="Xong" Style="{StaticResource GhostButton}" Height="38" Width="80" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
