<Window x:Class="PhenikaaCinema.Views.Booking.MovieSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn phim - PHENIKAA CINEMA" Height="780" Width="1100"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="25,0" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LOGO -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" Padding="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                        <Image Source="/Assets/phenikaa_logo.png" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="PHENIKAA" Foreground="{StaticResource PrimaryBlue}" FontSize="22" FontWeight="Black" Margin="0,0,6,0"/>
                    <TextBlock Text="CINEMA" Foreground="{StaticResource AccentOrange}" FontSize="22" FontWeight="Bold"/>
                    <Border Background="{StaticResource LightBlue}" CornerRadius="6" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ĐẶT VÉ TRỰC TUYẾN" Foreground="{StaticResource DarkBlue}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- SEARCH BAR -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Width="400" Height="40" Background="White" CornerRadius="20" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" Margin="20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0"
                                 VerticalContentAlignment="Center" FontSize="13" TextChanged="SearchBox_TextChanged" CaretBrush="{StaticResource PrimaryBlue}"/>
                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Tìm tên phim, thể loại, nội dung..." 
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" IsHitTestVisible="False" Margin="3,0,0,0"/>
                    </Grid>
                </Border>

                <!-- USER INFO / CLOSE -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource LightBlue}" CornerRadius="16" Padding="12,5" Margin="0,0,14,0">
                        <TextBlock x:Name="UserGreetText" Text="Xin chào!" Foreground="{StaticResource DarkBlue}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="✕  Đóng" Style="{StaticResource GhostButton}" Height="36" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTER BAR -->
        <Border Grid.Row="1" Background="White" Padding="25,12" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DANH SÁCH PHIM ĐANG CHIẾU" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <RadioButton x:Name="FilterAllRadio" Content="Tất cả phim" IsChecked="True" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" Margin="0,0,18,0" Checked="Filter_Checked"/>
                    <RadioButton x:Name="FilterNowShowingRadio" Content="Đang chiếu" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" Margin="0,0,18,0" Checked="Filter_Checked"/>
                </StackPanel>

                <Button Grid.Column="2" Content="🔄  Tải lại" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" Click="ReloadButton_Click"/>
            </Grid>
        </Border>

        <!-- MOVIE LIST / SCROLLVIEWER -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="28,24">
            <StackPanel>
                <TextBlock x:Name="StatusMessageText" Text="Đang tải danh sách phim..." Foreground="{StaticResource TextSecondary}" FontSize="14" 
                           HorizontalAlignment="Center" Margin="0,60,0,0" Visibility="Collapsed"/>

                <ItemsControl x:Name="MoviesItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER BAR -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="25,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="FooterStatusText" Text="Đang hiển thị 0 phim." Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="© PHENIKAA CINEMA" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
