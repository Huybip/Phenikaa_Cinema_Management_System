<Window x:Class="PhenikaaCinema.Views.Booking.ShowtimeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn suất chiếu - PHENIKAA CINEMA" Height="700" Width="1000"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="28,0" Effect="{StaticResource CardShadow}">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PHENIKAA" Foreground="{StaticResource PrimaryBlue}" FontSize="22" FontWeight="Black" Margin="0,0,6,0"/>
                    <TextBlock Text="CINEMA" Foreground="{StaticResource AccentOrange}" FontSize="22" FontWeight="Bold"/>
                    <Border Background="{StaticResource LightBlue}" CornerRadius="6" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CHỌN SUẤT CHIẾU" Foreground="{StaticResource DarkBlue}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <Button Content="✕  Đóng" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Height="36" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <!-- MOVIE BANNER & DATE FILTER -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- MOVIE MINI INFO -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,30,0">
                    <TextBlock x:Name="MovieTitleText" Text="Tên phim" Foreground="{StaticResource TextMain}" FontSize="20" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Background="{StaticResource LightBlue}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                            <TextBlock x:Name="MovieDurationText" Text="120 phút" Foreground="{StaticResource PrimaryBlue}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="MovieGenreText" Text="Hành động" Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- DATE SELECTOR -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Chọn ngày chiếu:" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel x:Name="DateTabsPanel" Orientation="Horizontal"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SHOWTIMES CONTENT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="28,22">
            <StackPanel>
                <TextBlock x:Name="EmptyShowtimeMessage" Text="Không có suất chiếu khả dụng cho ngày này." 
                           Foreground="{StaticResource TextSecondary}" FontSize="15" HorizontalAlignment="Center" Margin="0,50,0,0" Visibility="Collapsed"/>

                <ItemsControl x:Name="ShowtimeItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="28,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="* Lưu ý: Các suất chiếu đã diễn ra hoặc sắp chiếu trong 10 phút không thể đặt vé." Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="← Quay lại danh sách phim" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Height="36" Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
