<Window x:Class="PhenikaaCinema.Views.Booking.MockPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cổng thanh toán mô phỏng - PHENIKAA CINEMA" Height="520" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}" ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="25,0" Effect="{StaticResource CardShadow}">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PHENIKAA" Foreground="{StaticResource PrimaryBlue}" FontSize="20" FontWeight="Black" Margin="0,0,6,0"/>
                    <TextBlock Text="CINEMA" Foreground="{StaticResource AccentOrange}" FontSize="20" FontWeight="Bold"/>
                    <Border Background="{StaticResource LightBlue}" CornerRadius="6" Padding="8,3" Margin="10,0,0,0">
                        <TextBlock Text="CỔNG THANH TOÁN MÔ PHỎNG" Foreground="{StaticResource DarkBlue}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Border Grid.Row="1" Padding="32,22">
            <StackPanel>
                <!-- NOTICE -->
                <Border Background="{StaticResource LightBlue}" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                    <TextBlock Text="ℹ️ Đây là môi trường thanh toán thử nghiệm (Test/Dev). Không trừ tiền thật từ tài khoản ngân hàng." 
                               Foreground="{StaticResource DarkBlue}" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- AMOUNT CARD -->
                <Border Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,18" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="MÃ ĐƠN HÀNG:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="BookingCodeText" Text="BK202610280001" Foreground="{StaticResource PrimaryBlue}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="SỐ TIỀN THANH TOÁN:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="AmountText" Text="160.000 đ" Foreground="{StaticResource AccentOrange}" FontSize="22" FontWeight="Black" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PAYMENT METHOD CHOOSER -->
                <TextBlock Text="CHỌN HÌNH THỨC THANH TOÁN:" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Margin="0,0,0,12">
                    <RadioButton x:Name="RadioVnpay" Content="💳  Cổng VNPAY / Thẻ nội địa (Mô phỏng)" IsChecked="True" Foreground="{StaticResource TextMain}" FontSize="13" Margin="0,0,0,10"/>
                    <RadioButton x:Name="RadioMomo" Content="📱  Ví điện tử MoMo / ZaloPay (Mô phỏng)" Foreground="{StaticResource TextMain}" FontSize="13" Margin="0,0,0,10"/>
                    <RadioButton x:Name="RadioCash" Content="💵  Tiền mặt tại quầy (Dành cho nhân viên)" Foreground="{StaticResource TextMain}" FontSize="13"/>
                </StackPanel>

                <!-- STATUS MESSAGE -->
                <TextBlock x:Name="StatusMessage" Text="" Foreground="{StaticResource Error}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- FOOTER BUTTONS -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="32,0" Effect="{StaticResource CardShadow}">
            <Grid VerticalAlignment="Center">
                <Button Content="Hủy bỏ" Style="{StaticResource SecondaryButton}" Height="40" Padding="18,0" HorizontalAlignment="Left" Click="CancelButton_Click"/>
                <Button x:Name="ConfirmPayButton" Content="XÁC NHẬN THANH TOÁN →" Style="{StaticResource AccentButton}" Height="40" Padding="24,0" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" Click="ConfirmPayButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
