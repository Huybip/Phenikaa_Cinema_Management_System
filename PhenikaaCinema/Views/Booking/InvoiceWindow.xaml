<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PhenikaaCinema.Views.Booking.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HÓA ĐƠN THANH TOÁN TIỀN VÉ - PHENIKAA CINEMA"
        Height="820" Width="680"
        MinHeight="600" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,0" Effect="{StaticResource CardShadow}">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0" Padding="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                        <Image Source="/Assets/phenikaa_logo.png" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="PHENIKAA CINEMA" Foreground="{StaticResource PrimaryBlue}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" | Hóa đơn thanh toán" Foreground="{StaticResource TextSecondary}" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🖨  In hóa đơn" Style="{StaticResource PrimaryButton}" Height="36" Padding="16,0" Margin="0,0,10,0" Click="PrintButton_Click"/>
                    <Button Content="Đóng" Style="{StaticResource SecondaryButton}" Height="36" Width="80" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SCROLLABLE INVOICE PAPER -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16">
            <!-- PRINTABLE PAPER ELEMENT (INVOICE PAPER) -->
            <Border x:Name="InvoicePaper" Width="580" Background="White" 
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                    CornerRadius="8" Padding="32,28" HorizontalAlignment="Center" 
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <!-- INVOICE HEADER -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="64" Height="64" CornerRadius="8" Background="White" Margin="0,0,16,0" VerticalAlignment="Center" Padding="4" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                            <Image Source="/Assets/phenikaa_logo.png" Stretch="Uniform"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="TRƯỜNG ĐẠI HỌC PHENIKAA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DarkBlue}"/>
                            <TextBlock Text="PHENIKAA CINEMA" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryBlue}" Margin="0,2,0,2"/>
                            <TextBlock Text="📍 Đường Tố Hữu, P. Yên Nghĩa, Q. Hà Đông, TP. Hà Nội" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="📞 Hotline: 024.6291.8118 • Website: cinema.phenikaa-uni.edu.vn" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Grid>

                    <!-- DIVIDER DASHED -->
                    <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,4,0,14"/>

                    <!-- INVOICE TITLE -->
                    <TextBlock Text="HÓA ĐƠN THANH TOÁN TIỀN VÉ" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                    <TextBlock Text="(PHIẾU XÁC NHẬN ĐẶT VÉ VÀ THANH TOÁN)" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,14"/>

                    <!-- INVOICE INFO GRID -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Mã hóa đơn: " FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtBookingCode" Text="BK202611080001" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Khách hàng: " FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtCustomerName" Text="Khách hàng" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Số điện thoại: " FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtCustomerPhone" Text="0987654321" FontSize="12" Foreground="{StaticResource TextMain}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" HorizontalAlignment="Right">
                                    <TextBlock Text="Ngày thanh toán: " FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtPaymentDate" Text="08/11/2026 18:30" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" HorizontalAlignment="Right">
                                    <TextBlock Text="Hình thức: " FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtPaymentMethod" Text="VNPAY / Trực tuyến" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                </StackPanel>
                                <Border Background="#DCFCE7" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                                    <TextBlock Text="✔ ĐÃ THANH TOÁN (PAID)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Success}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MOVIE & SHOWTIME INFO -->
                    <Border Background="#EFF6FF" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="BỘ PHIM:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock x:Name="TxtMovieTitle" Text="TÊN BỘ PHIM" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DarkBlue}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="PHÒNG CHIẾU:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="TxtRoomName" Text="Phòng chiếu 01" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Right" Margin="0,2,0,4"/>
                                <TextBlock x:Name="TxtShowtime" Text="19:30 • 08/11/2026" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SEATS & TICKETS TABLE -->
                    <TextBlock Text="CHI TIẾT VÉ VÀ GHẾ ĐÃ ĐẶT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,8"/>
                    
                    <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16" ClipToBounds="True">
                        <StackPanel>
                            <!-- Table Header -->
                            <Border Background="#F1F5F9" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="STT" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Grid.Column="1" Text="VỊ TRÍ GHẾ" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Grid.Column="2" Text="LOẠI GHẾ" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Grid.Column="3" Text="MÃ VÉ" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Grid.Column="4" Text="ĐƠN GIÁ" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMain}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Table Items Container -->
                            <ItemsControl x:Name="InvoiceSeatsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Index}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SeatLabel}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DarkBlue}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SeatType}" FontSize="12" Foreground="{StaticResource TextMain}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding TicketCode}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding FormattedPrice}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- PAYMENT SUMMARY -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <!-- Words notation -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Số tiền viết bằng chữ:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TxtAmountInWords" Text="Một trăm sáu mươi nghìn đồng chẵn." FontSize="12" FontStyle="Italic" Foreground="{StaticResource TextMain}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Subtotal, Discount, Total -->
                        <StackPanel Grid.Column="1">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Tạm tính:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtSubTotal" Text="160.000 ₫" FontSize="12" Foreground="{StaticResource TextMain}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Giảm giá:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtDiscount" Text="0 ₫" FontSize="12" Foreground="{StaticResource Success}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,2,0,6"/>
                            <Grid>
                                <TextBlock Text="TỔNG TIỀN:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtFinalTotal" Text="160.000 ₫" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource AccentOrange}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- DIVIDER DASHED -->
                    <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,8,0,14"/>

                    <!-- FOOTER THANKS & NOTICE -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="CẢM ƠN QUÝ KHÁCH ĐÃ LỰA CHỌN PHENIKAA CINEMA!" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chúc quý khách có những giây phút thưởng thức điện ảnh trọn vẹn và vui vẻ!" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="* Vé đã thanh toán không áp dụng đổi trả sau khi suất chiếu bắt đầu." FontSize="10" FontStyle="Italic" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- FOOTER ACTIONS BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,0" Effect="{StaticResource CardShadow}">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="* Hỗ trợ in qua máy in nhiệt quầy vé (POS) hoặc máy in văn phòng / xuất PDF." Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="🖨  IN HÓA ĐƠN NGAY" Style="{StaticResource PrimaryButton}" Height="40" Padding="24,0" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" Click="PrintButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>

