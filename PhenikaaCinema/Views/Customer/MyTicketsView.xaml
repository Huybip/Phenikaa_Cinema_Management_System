<UserControl x:Class="PhenikaaCinema.Views.Customer.MyTicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="{StaticResource BgMain}"
             FontFamily="Segoe UI">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER BANNER -->
        <Border Grid.Row="0" Background="White" CornerRadius="14" Padding="24,18" Margin="0,0,0,18" 
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VÉ ĐIỆN TỬ CỦA TÔI" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryBlue}"/>
                    <TextBlock Text="Xem mã vé, thông tin phòng chiếu, vị trí ghế và xuất trình tại quầy soát vé rạp PHENIKAA" 
                               FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄  Tải lại vé" 
                        Style="{StaticResource SecondaryButton}" 
                        Height="38"
                        Click="BtnRefresh_Click"/>
            </Grid>
        </Border>

        <!-- SEARCH & FILTER TOOLBAR -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,18" 
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                Effect="{StaticResource CardShadow}">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                    <TextBlock Text="🔍  Tìm kiếm vé:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                    <TextBox x:Name="SearchBox" Width="260" Style="{StaticResource InputBox}" Height="36"
                             TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <TextBlock x:Name="TicketSummaryText" Text="Đang tải danh sách vé..." 
                           VerticalAlignment="Center" Foreground="{StaticResource PrimaryBlue}" 
                           FontWeight="SemiBold" Margin="8,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- TICKET CARDS GRID -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <ItemsControl x:Name="TicketsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="330" Margin="0,0,18,18" Background="White" CornerRadius="14" 
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="20"
                                    Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <!-- Header ticket: Code and status -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TicketCode}" Foreground="{StaticResource PrimaryBlue}" FontWeight="ExtraBold" FontSize="15"/>
                                        <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Success}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Divider dashed line -->
                                    <Line X1="0" Y1="0" X2="290" Y2="0" Stroke="{StaticResource BorderColor}" StrokeThickness="1" StrokeDashArray="4 2" Margin="0,0,0,14"/>

                                    <TextBlock Text="{Binding MovieTitle}" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StartTimeVn, StringFormat='Suất chiếu: {0:dd/MM/yyyy HH:mm}'}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding RoomName, StringFormat='Phòng chiếu: {0}'}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>

                                    <!-- Seat & Price Pill -->
                                    <Border Background="{StaticResource BgMain}" CornerRadius="10" Padding="14,10" Margin="0,12,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="VỊ TRÍ GHẾ" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SeatCode}" Foreground="{StaticResource PrimaryBlue}" FontSize="18" FontWeight="Black"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="GIÁ VÉ" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding FormattedPrice}" Foreground="{StaticResource AccentOrange}" FontSize="15" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Button Content="🎟  Xem chi tiết vé" 
                                            Style="{StaticResource AccentButton}" 
                                            Height="38"
                                            Tag="{Binding TicketId}" 
                                            Click="BtnViewSingleTicket_Click"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyTicketsText" Text="Bạn chưa có vé điện tử nào." 
                           Foreground="{StaticResource TextSecondary}" 
                           FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
