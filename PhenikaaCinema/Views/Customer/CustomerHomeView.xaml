<UserControl x:Class="PhenikaaCinema.Views.Customer.CustomerHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:graphics="clr-namespace:PhenikaaCinema.Views.Graphics"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1150"
             Background="{StaticResource BgMain}"
             FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">

            <!-- 2D / 3D HERO BANNER (White Card with Blue/Orange Brand) -->
            <Border Background="White" CornerRadius="18" Padding="32,28" Margin="0,0,0,26" 
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                            <Border Background="White" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" Padding="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <Image Source="/Assets/phenikaa_emblem.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <Border Background="{StaticResource LightBlue}" CornerRadius="6" HorizontalAlignment="Left" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="ĐẶT VÉ TRỰC TUYẾN 2D / 3D HIỆN ĐẠI" Foreground="{StaticResource PrimaryBlue}" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="WelcomeTitleText"
                                   Text="Chào mừng bạn đến với PHENIKAA CINEMA!" 
                                   Foreground="{StaticResource TextMain}" FontSize="26" FontWeight="ExtraBold" TextWrapping="Wrap"/>

                        <TextBlock Text="Khám phá các bom tấn điện ảnh, chọn ghế trực quan trên sơ đồ 2D và trải nghiệm không gian phòng chiếu 3D chân thực." 
                                   Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,8,0,22" TextWrapping="Wrap" MaxWidth="620" LineHeight="22"/>

                        <WrapPanel>
                            <Button Content="🎟  Đặt vé xem phim ngay" Style="{StaticResource AccentButton}" Click="BtnBookNow_Click" Margin="0,0,12,0"/>
                            <Button Content="🎫  Vé của tôi" Style="{StaticResource PrimaryButton}" Click="BtnMyTickets_Click" Margin="0,0,12,0"/>
                            <Button Content="🔄  Làm mới" Style="{StaticResource SecondaryButton}" Click="BtnRefresh_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Interactive 3D Showcase Poster in Hero Banner -->
                    <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <graphics:MoviePoster3DControl x:Name="HeroPoster3D" Width="260" Height="200"/>
                    </Border>
                </Grid>
            </Border>

            <!-- DỊCH VỤ NHANH (White Cards) -->
            <TextBlock Text="DỊCH VỤ NHANH" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" FontSize="12" Margin="4,0,0,12"/>
            <UniformGrid Columns="4" Margin="0,0,0,28">
                <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,12,0" 
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource LightBlue}" HorizontalAlignment="Left">
                            <TextBlock Text="🎬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Chọn phim" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,12,0,4"/>
                        <TextBlock Text="Danh sách phim đang chiếu tại rạp" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        <Button Content="Xem danh sách" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0" Click="BtnBrowseMovies_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,12,0" 
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource LightOrange}" HorizontalAlignment="Left">
                            <TextBlock Text="🕒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Lịch chiếu" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,12,0,4"/>
                        <TextBlock Text="Tra cứu các khung giờ chiếu phim" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        <Button Content="Xem lịch chiếu" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0" Click="BtnShowtimes_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,12,0" 
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <Border Width="46" Height="46" CornerRadius="23" Background="#DCFCE7" HorizontalAlignment="Left">
                            <TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Lịch sử đặt vé" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,12,0,4"/>
                        <TextBlock Text="Quản lý và tra cứu các đơn đặt vé" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        <Button Content="Lịch sử đặt" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0" Click="BtnMyBookings_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="14" Padding="20" 
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <Border Width="46" Height="46" CornerRadius="23" Background="#F3E8FF" HorizontalAlignment="Left">
                            <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Tài khoản" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,12,0,4"/>
                        <TextBlock Text="Xem và chỉnh sửa hồ sơ cá nhân" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        <Button Content="Hồ sơ của tôi" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0" Click="BtnProfile_Click"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- DANH SÁCH PHIM ĐANG CHIẾU (POSTER CARD HOVER 2D ZOOM) -->
            <Grid Margin="4,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="PHIM ĐANG CHIẾU NỔI BẬT" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="MovieCountText" Grid.Column="1" Text="Đang tải..." Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
            </Grid>

            <ItemsControl x:Name="MoviesListControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Card with RenderTransform scale hover -->
                        <Border Width="240" Margin="0,0,16,20" Background="White" CornerRadius="14" 
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                Effect="{StaticResource CardShadow}"
                                RenderTransformOrigin="0.5, 0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <!-- Khung Poster phim -->
                                <Border Height="210" Background="{StaticResource LightBlue}" CornerRadius="14,14,0,0" ClipToBounds="True">
                                    <Grid>
                                        <!-- Fallback nền khi không có ảnh hoặc đang tải -->
                                        <Border Background="{StaticResource DarkBlue}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8B2;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="PHENIKAA CINEMA" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Ảnh poster thực tế -->
                                        <Image Source="{Binding PosterImageSource}" Stretch="UniformToFill" 
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Status Badge -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Background="{StaticResource AccentOrange}" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Duration Badge -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Background="#B00F172A" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding FormattedDuration}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Thông tin chi tiết phim -->
                                <StackPanel Margin="16">
                                    <Border Background="{StaticResource LightBlue}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding DisplayGenres}" Foreground="{StaticResource DarkBlue}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Bold" 
                                               TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" Margin="0,2,0,12"/>
                                    <Button Content="Đặt vé ngay" Style="{StaticResource AccentButton}" Tag="{Binding MovieId}" Click="BtnBookMovieItem_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- CHƯƠNG TRÌNH KHUYẾN MÃI -->
            <TextBlock Text="ƯU ĐÃI ĐẶC BIỆT" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="Bold" Margin="4,16,0,14"/>
            <ItemsControl x:Name="PromotionsListControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="340" Margin="0,0,16,16" Background="White" CornerRadius="12" 
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="16"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" Background="{StaticResource LightOrange}" CornerRadius="10" Margin="0,0,14,0">
                                    <TextBlock Text="🎁" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PromotionCode}" Foreground="{StaticResource AccentOrange}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding FormattedDiscount}" Foreground="{StaticResource Success}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
