<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PhenikaaCinema.Views.Admin.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PHENIKAA CINEMA | Quản trị hệ thống"
        Height="840" Width="1340"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR (Modern Deep Blue) -->
        <Border Grid.Column="0" Background="{StaticResource DarkBlue}">
            <Grid Margin="18,24,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BRAND HEADER -->
                <StackPanel Grid.Row="0" Margin="6,0,6,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="White" CornerRadius="8" Width="38" Height="38" Margin="0,0,10,0" Padding="3">
                            <Image Source="/Assets/phenikaa_emblem.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PHENIKAA"
                                           FontSize="18"
                                           FontWeight="ExtraBold"
                                           Foreground="White"/>
                                <TextBlock Text=" CINEMA"
                                           FontSize="18"
                                           FontWeight="ExtraBold"
                                           Foreground="{StaticResource AccentOrange}"/>
                            </StackPanel>
                            <TextBlock Text="CỔNG QUẢN TRỊ VIÊN"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#93C5FD"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- NAVIGATION BUTTONS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="BÁO CÁO &amp; THỐNG KÊ"
                                   Foreground="#93C5FD"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="10,0,0,8"/>

                        <Button x:Name="BtnSidebarOverview"
                                Style="{StaticResource ActiveSidebarButton}"
                                Margin="0,0,0,4"
                                Click="OverviewButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Tổng quan 2D / 3D" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSidebarRevenue"
                                Style="{StaticResource SidebarButton}"
                                Margin="0,0,0,16"
                                Click="RevenueReportButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Báo cáo doanh thu" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="QUẢN LÝ NGHIỆP VỤ"
                                   Foreground="#93C5FD"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="10,0,0,8"/>

                        <Button Style="{StaticResource SidebarButton}"
                                Margin="0,0,0,4"
                                Click="MoviesButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B2;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Quản lý phim" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                                Margin="0,0,0,4"
                                Click="GenresButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Thể loại phim" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                                Margin="0,0,0,4"
                                Click="ShowtimesButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Quản lý suất chiếu" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                                Margin="0,0,0,4"
                                Click="RoomsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Quản lý phòng &amp; ghế" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                                Margin="0,0,0,4"
                                Click="UsersButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Quản lý tài khoản" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                                Margin="0,0,0,4"
                                Click="BookingsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Quản lý đặt vé" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                                Margin="0,0,0,4"
                                Click="PromotionsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB05;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Quản lý khuyến mãi" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- FOOTER / USER PROFILE & LOGOUT -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <Border Background="#173591" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="18" Background="#2563EB" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="AdminNameText" Text="Quản trị viên" Foreground="White" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" FontFamily="Segoe UI"/>
                                <TextBlock Text="ADMINISTRATOR" Foreground="{StaticResource AccentOrange}" FontSize="10" FontWeight="Bold" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource DangerButton}"
                            Height="38"
                            FontWeight="SemiBold"
                            Click="LogoutButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF3B1;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Đăng xuất" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <ContentControl Grid.Column="1" x:Name="AdminMainContent" Background="{StaticResource BgMain}"/>
    </Grid>
</Window>
