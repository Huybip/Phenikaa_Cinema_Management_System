<Window x:Class="PhenikaaCinema.Views.Admin.ShowtimeManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý suất chiếu - PHENIKAA CINEMA"
        Height="780" Width="1250" MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterOwner" Background="#F4F8FC">
    <Window.Resources>
        <SolidColorBrush x:Key="BlueBrush" Color="#1769AA"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="#F58220"/>
        <SolidColorBrush x:Key="DarkBrush" Color="#124B7A"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1769AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Content="Đóng" DockPanel.Dock="Right" Background="#64748B" VerticalAlignment="Center" Click="CloseButton_Click"/>
            <StackPanel>
                <TextBlock Text="QUẢN LÝ SUẤT CHIẾU" FontSize="25" FontWeight="Bold" Foreground="#124B7A"/>
                <TextBlock Text="PHENIKAA CINEMA" FontSize="13" Foreground="#F58220" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <DockPanel>
                <TextBox x:Name="SearchTextBox" Width="330" Margin="0,0,10,0" VerticalContentAlignment="Center"
                         ToolTip="Tìm theo phim, phòng, trạng thái hoặc mã suất" TextChanged="SearchTextBox_TextChanged"/>
                <Button Content="Tìm kiếm" Click="SearchButton_Click" Margin="0,0,8,0"/>
                <Button Content="Làm mới" Background="#64748B" Click="RefreshButton_Click" Margin="0"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="DANH SÁCH SUẤT CHIẾU" FontWeight="Bold" FontSize="16" Foreground="#124B7A" Margin="0,0,0,12"/>
                    <DataGrid x:Name="ShowtimesDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single" SelectionChanged="ShowtimesDataGrid_SelectionChanged"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowBackground="White" AlternatingRowBackground="#F4F8FC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding ShowtimeId}" Width="45"/>
                            <DataGridTextColumn Header="Phim" Binding="{Binding MovieTitle}" Width="*"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="85"/>
                            <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartTimeLocal, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="130"/>
                            <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndTimeLocal, StringFormat={}{0:HH:mm}}" Width="75"/>
                            <DataGridTextColumn Header="Giá vé" Binding="{Binding BasePrice, StringFormat={}{0:N0}}" Width="85"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN SUẤT CHIẾU" FontWeight="Bold" FontSize="17" Foreground="#124B7A" Margin="0,0,0,16"/>
                        <TextBlock Text="Mã suất chiếu (tự động)"/>
                        <TextBox x:Name="ShowtimeIdTextBox" IsReadOnly="True" Background="#F1F5F9"/>
                        <TextBlock Text="Phim"/>
                        <ComboBox x:Name="MovieComboBox" DisplayMemberPath="Title" SelectedValuePath="MovieId" SelectionChanged="MovieComboBox_SelectionChanged"/>
                        <TextBlock Text="Phòng chiếu"/>
                        <ComboBox x:Name="RoomComboBox" DisplayMemberPath="RoomName" SelectedValuePath="RoomId"/>
                        <TextBlock Text="Ngày chiếu"/>
                        <DatePicker x:Name="ShowDatePicker" SelectedDateChanged="ScheduleInput_Changed"/>
                        <TextBlock Text="Giờ bắt đầu (HH:mm)"/>
                        <TextBox x:Name="StartTimeTextBox" Text="19:00" TextChanged="ScheduleInput_TextChanged"/>
                        <TextBlock Text="Giờ kết thúc (tự động theo thời lượng phim)"/>
                        <TextBox x:Name="EndTimeTextBox" IsReadOnly="True" Background="#F1F5F9" Text="21:00"/>
                        <TextBlock Text="Thời lượng phim"/>
                        <TextBox x:Name="DurationTextBox" IsReadOnly="True" Background="#F1F5F9"/>
                        <TextBlock Text="Giá vé cơ bản (VND)"/>
                        <TextBox x:Name="BasePriceTextBox" Text="80000"/>
                        <TextBlock Text="Trạng thái"/>
                        <ComboBox x:Name="StatusComboBox" SelectedIndex="0">
                            <ComboBoxItem Content="Scheduled"/>
                            <ComboBoxItem Content="Cancelled"/>
                        </ComboBox>
                        <TextBlock Text="Giờ nhập theo Việt Nam (UTC+7); database lưu UTC. Không thể thay đổi lịch của suất đã có ghế đặt." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <WrapPanel>
                            <Button Content="Thêm" Click="AddButton_Click"/>
                            <Button Content="Cập nhật" Background="#F58220" Click="UpdateButton_Click"/>
                            <Button Content="Hủy suất" Background="#DC2626" Click="CancelButton_Click"/>
                            <Button Content="Xóa trắng" Background="#64748B" Click="ClearButton_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="PHENIKAA CINEMA | Quản lý suất chiếu" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </Grid>
</Window>