<Window x:Class="PhenikaaCinema.Views.Admin.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý người dùng - PHENIKAA CINEMA"
        Height="720" Width="1180"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#17365D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Height" Value="38"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="QUẢN LÝ NGƯỜI DÙNG"
                       FontSize="25" FontWeight="Bold"
                       Foreground="#17365D"/>
            <TextBlock Text="Quản lý tài khoản, vai trò và trạng thái hoạt động"
                       FontSize="13" Foreground="#64748B"
                       Margin="0,5,0,0"/>
        </StackPanel>
        <Button
        Content="Đóng / Quay lại"
        Width="130"
        Height="35"
        Margin="10"
        Click="CloseButton_Click" />

        <Border Grid.Row="1" Background="White"
                CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <TextBox x:Name="SearchTextBox"
                         Width="350" Margin="0,0,10,0"
                         ToolTip="Tìm theo tên, email hoặc số điện thoại"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged"/>
                <Button Content="Làm mới"
                        Click="RefreshButton_Click"
                        Background="#17365D" Foreground="White"/>
                <Button Content="Thêm người dùng"
                        Click="AddButton_Click"
                        Background="#E87524" Foreground="White"/>
                <Button Content="Cập nhật"
                        Click="UpdateButton_Click"
                        Background="#2878B5" Foreground="White"/>
                <Button Content="Đổi trạng thái"
                        Click="ToggleStatusButton_Click"
                        Background="#475569" Foreground="White"/>
                <Button
                        Content="Xóa người dùng"
                        Width="130"
                        Height="35"
                        Margin="5"
                        Background="#DC2626"
                        Foreground="White"
                        Click="DeleteButton_Click" />
            </DockPanel>
        </Border>

        <DataGrid x:Name="UsersDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  BorderBrush="#D8E1EC"
                  RowHeight="38"
                  SelectionChanged="UsersDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding UserId}"
                                    Width="55"/>
                <DataGridTextColumn Header="Họ và tên"
                                    Binding="{Binding FullName}"
                                    Width="*"/>
                <DataGridTextColumn Header="Email"
                                    Binding="{Binding Email}"
                                    Width="1.5*"/>
                <DataGridTextColumn Header="Điện thoại"
                                    Binding="{Binding Phone}"
                                    Width="120"/>
                <DataGridTextColumn Header="Vai trò"
                                    Binding="{Binding RoleName}"
                                    Width="105"/>
                <DataGridCheckBoxColumn Header="Hoạt động"
                                        Binding="{Binding IsActive}"
                                        Width="95"/>
                <DataGridTextColumn Header="Ngày tạo (UTC)"
                                    Binding="{Binding CreatedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                    Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="White"
                CornerRadius="8" Padding="14" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Họ và tên"/>
                    <TextBox x:Name="FullNameTextBox"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Email"/>
                    <TextBox x:Name="EmailTextBox"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="Số điện thoại"/>
                    <TextBox x:Name="PhoneTextBox"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="10,0,0,0">
                    <TextBlock Text="Vai trò"/>
                    <ComboBox x:Name="RoleComboBox"
                              DisplayMemberPath="RoleName"
                              SelectedValuePath="RoleId"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
