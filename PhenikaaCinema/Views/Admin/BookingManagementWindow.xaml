<Window x:Class="PhenikaaCinema.Views.Admin.BookingManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý đặt vé - PHENIKAA CINEMA"
        Height="650" Width="1100"
        MinHeight="550" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="#FFF8F5F0"
        Foreground="#263238">

    <Window.Resources>

        <!-- Màu sắc chủ đạo -->
        <SolidColorBrush x:Key="OrangeBrush" Color="#F58220"/>
        <SolidColorBrush x:Key="OrangeHoverBrush" Color="#FF9D42"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#2471A3"/>
        <SolidColorBrush x:Key="BlueHoverBrush" Color="#3498DB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#263238"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E0E5EA"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>

        <!-- Nút màu cam -->
        <Style x:Key="OrangeButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource OrangeHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút màu xanh -->
        <Style x:Key="BlueButton" TargetType="Button"
               BasedOn="{StaticResource OrangeButton}">
            <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource BlueHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút nền trắng -->
        <Style x:Key="WhiteButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Ô tìm kiếm -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Bộ lọc trạng thái -->
        <Style x:Key="StatusComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Bảng dữ liệu -->
        <Style x:Key="BookingGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF8F5F0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE8E8E8"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFF0F0F0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <!-- Tiêu đề cột -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF58220"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#FFFFA044"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Dòng được chọn -->
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFDCECF7"/>
                    <Setter Property="Foreground" Value="#174A6E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#FFE0E5EA"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,18">

            <StackPanel>
                <TextBlock Text="QUẢN LÝ ĐẶT VÉ"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#263238"/>

                <TextBlock Text="Theo dõi, tra cứu và quản lý các đơn đặt vé"
                           FontSize="13"
                           Foreground="#718096"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tìm kiếm và bộ lọc -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#FFE0E5EA"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Height="38"
                         Margin="0,0,10,0"
                         Style="{StaticResource SearchBoxStyle}"
                         ToolTip="Tìm theo mã đặt vé hoặc tên khách hàng"
                         TextChanged="SearchTextBox_TextChanged"/>

                <ComboBox x:Name="StatusComboBox"
                          Grid.Column="1"
                          Margin="0,0,10,0"
                          Height="38"
                          Style="{StaticResource StatusComboStyle}"
                          SelectionChanged="StatusComboBox_SelectionChanged">
                    <ComboBoxItem Content="Tất cả trạng thái"
                                  IsSelected="True"/>
                    <ComboBoxItem Content="PendingPayment"/>
                    <ComboBoxItem Content="Confirmed"/>
                    <ComboBoxItem Content="Cancelled"/>
                    <ComboBoxItem Content="Expired"/>
                </ComboBox>

                <Button Grid.Column="2"
                        Content="↻  Làm mới"
                        Click="RefreshButton_Click"
                        Margin="0,0,10,0"
                        Style="{StaticResource BlueButton}"/>

                <Button Grid.Column="3"
                        Content="▣  Xem thanh toán"
                        Click="PaymentButton_Click"
                        Style="{StaticResource OrangeButton}"/>
            </Grid>
        </Border>

        <!-- Bảng đặt vé -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#FFE0E5EA"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8">

            <DataGrid x:Name="BookingsGrid"
                      Style="{StaticResource BookingGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      AlternationCount="2">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding BookingId}"
                                        Width="55"/>

                    <DataGridTextColumn Header="Mã đặt vé"
                                        Binding="{Binding BookingCode}"
                                        Width="190"/>

                    <DataGridTextColumn Header="Khách hàng"
                                        Binding="{Binding CustomerName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Phim"
                                        Binding="{Binding MovieTitle}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Thời gian đặt (VN)"
                                        Binding="{Binding BookingTimeLocal}"
                                        Width="155"/>

                    <DataGridTextColumn Header="Trạng thái"
                                        Binding="{Binding Status}"
                                        Width="125"/>

                    <DataGridTextColumn Header="Tổng tiền"
                                        Binding="{Binding FinalAmount, StringFormat={}{0:N0} đ}"
                                        Width="115"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Khu vực thao tác cuối màn hình -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#FFE0E5EA"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,16,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="9"
                             Height="9"
                             Fill="#F58220"
                             Margin="0,0,8,0"/>

                    <TextBlock Text="Chỉ có thể hủy đơn đang chờ thanh toán."
                               Foreground="#5F6B76"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Hủy đơn chờ thanh toán"
                        Click="CancelButton_Click"
                        Style="{StaticResource OrangeButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
