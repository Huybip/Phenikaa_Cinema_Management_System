<Window x:Class="PhenikaaCinema.Views.Admin.RoomManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý phòng và ghế - PHENIKAA CINEMA"
        Height="820" Width="1420" MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterOwner" Background="#F4F8FC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1769AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Margin" Value="0,4,0,9"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,4,0,9"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F4F8FC"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="Đóng" DockPanel.Dock="Right" Background="#64748B"
                    VerticalAlignment="Center" Click="CloseButton_Click"/>
            <StackPanel>
                <TextBlock Text="QUẢN LÝ PHÒNG VÀ GHẾ" FontSize="25" FontWeight="Bold" Foreground="#124B7A"/>
                <TextBlock Text="PHENIKAA CINEMA · Sơ đồ ghế trực quan" FontSize="13" Foreground="#F58220" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <TextBox x:Name="SearchTextBox" Width="300" Margin="0,0,8,0" VerticalContentAlignment="Center"
                         ToolTip="Tìm phòng theo mã, tên hoặc trạng thái" TextChanged="SearchTextBox_TextChanged"/>
                <Button Content="Tìm phòng" Click="SearchButton_Click" Margin="0,0,8,0"/>
                <Button Content="Làm mới" Background="#64748B" Click="RefreshButton_Click" Margin="0"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.0*"/>
                <ColumnDefinition Width="2.2*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="DANH SÁCH PHÒNG" FontWeight="Bold" FontSize="16" Foreground="#124B7A" Margin="0,0,0,10"/>
                    <DataGrid x:Name="RoomsDataGrid" Grid.Row="1" SelectionChanged="RoomsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding RoomId}" Width="42"/>
                            <DataGridTextColumn Header="Tên phòng" Binding="{Binding RoomName}" Width="*"/>
                            <DataGridTextColumn Header="Ghế" Binding="{Binding SeatCount}" Width="48"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <TabControl Grid.Column="1" Background="White">
                <TabItem Header="Sơ đồ ghế">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="SeatRoomLabel" Text="Chọn một phòng ở danh sách bên trái." FontWeight="Bold" FontSize="16" Foreground="#124B7A"/>
                            <TextBlock Text="SƠ ĐỒ GHẾ · Chọn ghế trên sơ đồ hoặc trong danh sách để chỉnh sửa" Foreground="#64748B" Margin="0,4,0,8"/>
                            <Border Background="#DCE7F1" CornerRadius="5" Padding="6" Margin="45,0,45,8">
                                <TextBlock Text="M À N  H Ì N H" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#334155"/>
                            </Border>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SeatMapItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">
                                            <Border Width="28" Height="30" Background="#E2E8F0" CornerRadius="4" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding RowLabel}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#334155"/>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Seats}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding SeatLabel}" Tag="{Binding SeatId}" ToolTip="{Binding ToolTipText}"
                                                                Width="42" Height="32" Padding="1" Margin="2"
                                                                Background="{Binding SeatColor}" Foreground="{Binding TextColor}"
                                                                FontSize="10" FontWeight="Bold" Click="SeatMapButton_Click"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Grid.Row="3" Margin="0,10,0,0">
                            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="■ Standard" Foreground="#1769AA" Margin="8,3"/>
                                <TextBlock Text="■ VIP" Foreground="#7C3AED" Margin="8,3"/>
                                <TextBlock Text="■ Couple (Ghế đôi)" Foreground="#E11D48" Margin="8,3" FontWeight="Bold"/>
                                <TextBlock Text="■ Ngừng hoạt động" Foreground="#94A3B8" Margin="8,3"/>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="Làm mới ghế" Background="#64748B" Click="RefreshSeatsButton_Click"/>
                                <Button Content="Xóa trắng form" Background="#64748B" Click="ClearSeatButton_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Danh sách &amp; chỉnh sửa ghế">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="SeatsDataGrid" Grid.Row="0" SelectionChanged="SeatsDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã ghế" Binding="{Binding SeatId}" Width="60"/>
                                <DataGridTextColumn Header="Hàng" Binding="{Binding RowLabel}" Width="70"/>
                                <DataGridTextColumn Header="Số" Binding="{Binding SeatNumber}" Width="60"/>
                                <DataGridTextColumn Header="Loại ghế" Binding="{Binding SeatType}" Width="*"/>
                                <DataGridTextColumn Header="Phụ phí" Binding="{Binding ExtraPrice, StringFormat={}{0:N0}}" Width="100"/>
                                <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsActive}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Background="#F4F8FC" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="3">
                                    <TextBlock Text="Hàng ghế"/>
                                    <TextBox x:Name="SeatRowTextBox" MaxLength="5" ToolTip="Ví dụ A, B, C"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="3">
                                    <TextBlock Text="Số ghế"/>
                                    <TextBox x:Name="SeatNumberTextBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="3">
                                    <TextBlock Text="Loại ghế"/>
                                    <ComboBox x:Name="SeatTypeComboBox" IsEditable="True" Text="Standard">
                                        <ComboBoxItem Content="Standard"/>
                                        <ComboBoxItem Content="VIP"/>
                                        <ComboBoxItem Content="Couple"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="3">
                                    <TextBlock Text="Phụ phí (VND)"/>
                                    <TextBox x:Name="SeatExtraPriceTextBox" Text="0"/>
                                </StackPanel>
                                <CheckBox x:Name="SeatIsActiveCheckBox" Grid.ColumnSpan="4" Content="Ghế đang hoạt động" IsChecked="True" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </Grid>
                        </Border>
                        <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                            <Button Content="Thêm ghế" Click="AddSeatButton_Click"/>
                            <Button Content="Cập nhật ghế" Background="#F58220" Click="UpdateSeatButton_Click"/>
                            <Button Content="Xóa ghế" Background="#DC2626" Click="DeleteSeatButton_Click"/>
                        </WrapPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Thông tin phòng">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18">
                            <TextBlock Text="THÔNG TIN PHÒNG CHIẾU" FontWeight="Bold" FontSize="17" Foreground="#124B7A" Margin="0,0,0,14"/>
                            <TextBlock Text="Mã phòng (tự động)"/>
                            <TextBox x:Name="RoomIdTextBox" IsReadOnly="True" Background="#F1F5F9"/>
                            <TextBlock Text="Tên phòng"/>
                            <TextBox x:Name="RoomNameTextBox" MaxLength="100" ToolTip="Ví dụ: Room 3"/>
                            <TextBlock Text="Sức chứa (số ghế tối đa)"/>
                            <TextBox x:Name="CapacityTextBox" Text="20"/>
                            <CheckBox x:Name="IsActiveCheckBox" Content="Phòng đang hoạt động" IsChecked="True" Margin="0,4,0,16" FontSize="14"/>
                            <TextBlock Text="Ngày tạo (UTC)" Foreground="#64748B"/>
                            <TextBox x:Name="CreatedAtTextBox" IsReadOnly="True" Background="#F1F5F9"/>
                            <TextBlock Text="Không nên giảm sức chứa xuống thấp hơn số ghế đã tạo. Phòng có lịch chiếu hoặc đặt vé nên được tắt thay vì xóa." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="Thêm phòng" Click="AddButton_Click"/>
                                <Button Content="Cập nhật" Background="#F58220" Click="UpdateButton_Click"/>
                                <Button Content="Xóa trắng" Background="#64748B" Click="ClearButton_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
        <TextBlock Grid.Row="3" Text="PHENIKAA CINEMA | Quản lý phòng và ghế" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </Grid>
</Window>
