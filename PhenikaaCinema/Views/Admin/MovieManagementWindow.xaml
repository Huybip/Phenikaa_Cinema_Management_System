<Window x:Class="PhenikaaCinema.Views.Admin.MovieManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PHENIKAA CINEMA | Quản lý phim"
        Height="800" Width="1250"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        Background="#F4F8FC">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1769AA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#15324B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,7,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#D5E2EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White"
                CornerRadius="12"
                Padding="20"
                BorderBrush="#E1EAF2"
                BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Đóng"
                        Style="{StaticResource ActionButton}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click"/>

                <StackPanel>
                    <TextBlock Text="QUẢN LÝ PHIM"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#1769AA"/>
                    <TextBlock Text="Thêm, chỉnh sửa, tìm kiếm và quản lý danh sách phim."
                               Foreground="#63778A"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="16"
                Margin="0,16,0,16"
                BorderBrush="#E1EAF2"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Height="40"
                         VerticalAlignment="Center"
                         ToolTip="Nhập tên phim để tìm kiếm"
                         TextChanged="SearchTextBox_TextChanged"/>

                <Button Grid.Column="1"
                        Content="Làm mới"
                        Style="{StaticResource ActionButton}"
                        Margin="12,0,0,0"
                        Click="RefreshButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,12,0"
                    BorderBrush="#E1EAF2"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Danh sách phim"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#15324B"
                               Margin="0,0,0,12"/>

                    <DataGrid x:Name="MoviesDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              Background="White"
                              BorderThickness="0"
                              SelectionChanged="MoviesDataGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã"
                                                Binding="{Binding MovieId}"
                                                Width="48"/>

                            <DataGridTextColumn Header="Tên phim"
                                                Binding="{Binding Title}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Thời lượng"
                                                Binding="{Binding DurationMinutes}"
                                                Width="85"/>

                            <DataGridTextColumn Header="Trạng thái"
                                                Binding="{Binding Status}"
                                                Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    BorderBrush="#E1EAF2"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Thông tin phim"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#15324B"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Chọn phim bên trái để chỉnh sửa hoặc nhấn Thêm phim."
                                   Foreground="#63778A"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Tên phim *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TitleTextBox" MaxLength="200"/>

                        <TextBlock Text="Mô tả" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DescriptionTextBox"
                                 Height="75"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="Thời lượng (phút) *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DurationTextBox" MaxLength="6"/>

                        <TextBlock Text="Ngày phát hành" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="ReleaseDatePicker"/>

                        <TextBlock Text="Ngày kết thúc phát hành" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="EndDatePicker"/>

                        <TextBlock Text="Đường dẫn poster" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PosterUrlTextBox" MaxLength="500"/>

                        <TextBlock Text="Đường dẫn trailer" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TrailerUrlTextBox" MaxLength="500"/>

                        <TextBlock Text="Thể loại phim" Style="{StaticResource FieldLabel}"/>
                        <Border BorderBrush="#D5E2EE" BorderThickness="1" CornerRadius="6" Padding="8" Background="#FAFCFE" Margin="0,0,0,10">
                            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="GenresItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding GenreName}" IsChecked="{Binding IsSelected}" 
                                                      Margin="0,3,14,3" FontWeight="Normal" Foreground="#2A3B4C"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="Trạng thái *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="StatusComboBox"
                                  Height="35"
                                  Padding="6">
                            <ComboBoxItem Content="NowShowing"/>
                            <ComboBoxItem Content="ComingSoon"/>
                            <ComboBoxItem Content="Ended"/>
                        </ComboBox>

                        <WrapPanel Margin="0,18,0,0">
                            <Button Content="Thêm phim"
                                    Style="{StaticResource ActionButton}"
                                    Background="#1769AA"
                                    Click="AddButton_Click"/>

                            <Button Content="Cập nhật"
                                    Style="{StaticResource ActionButton}"
                                    Background="#F58220"
                                    Click="UpdateButton_Click"/>

                            <Button Content="Xóa phim"
                                    Style="{StaticResource ActionButton}"
                                    Background="#C43D3D"
                                    Click="DeleteButton_Click"/>

                            <Button Content="Xóa biểu mẫu"
                                    Style="{StaticResource ActionButton}"
                                    Background="#63778A"
                                    Click="ClearButton_Click"/>
                        </WrapPanel>

                        <TextBlock Text="* Các trường bắt buộc phải nhập."
                                   Foreground="#63778A"
                                   FontSize="12"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
