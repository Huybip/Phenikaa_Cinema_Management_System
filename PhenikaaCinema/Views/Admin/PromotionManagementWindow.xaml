<Window x:Class="PhenikaaCinema.Views.Admin.PromotionManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý khuyến mãi - PHENIKAA CINEMA"
        Height="720" Width="1150"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterOwner"
        Background="#FFF8F5F0"
        Foreground="#263238">

    <Window.Resources>
        <SolidColorBrush x:Key="OrangeBrush" Color="#F58220"/>
        <SolidColorBrush x:Key="OrangeHoverBrush" Color="#FF9D42"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#2471A3"/>
        <SolidColorBrush x:Key="BlueHoverBrush" Color="#3498DB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#263238"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E0E5EA"/>

        <Style x:Key="OrangeButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource OrangeHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlueButton" TargetType="Button"
               BasedOn="{StaticResource OrangeButton}">
            <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource BlueHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F58220"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCECF7"/>
                    <Setter Property="Foreground" Value="#174A6E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E0E5EA" BorderThickness="1"
                CornerRadius="10" Padding="18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="QUẢN LÝ KHUYẾN MÃI"
                           FontSize="25" FontWeight="Bold"
                           Foreground="#263238"/>
                <TextBlock Text="Tạo, cập nhật và theo dõi mã ưu đãi"
                           FontSize="13" Foreground="#718096"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tìm kiếm -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#E0E5EA" BorderThickness="1"
                CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Style="{StaticResource InputStyle}"
                         ToolTip="Tìm theo mã hoặc mô tả khuyến mãi"
                         TextChanged="SearchTextBox_TextChanged"/>

                <Button Grid.Column="1" Content="Tìm kiếm"
                        Click="SearchButton_Click"
                        Style="{StaticResource BlueButton}"/>

                <Button Grid.Column="2" Content="Làm mới"
                        Click="RefreshButton_Click"
                        Style="{StaticResource BlueButton}"/>
            </Grid>
        </Border>

        <!-- Form nhập liệu -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#E0E5EA" BorderThickness="1"
                CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Mã khuyến mãi"
                           FontWeight="SemiBold" Margin="4"
                           Foreground="#263238"/>
                <TextBlock Grid.Column="1" Text="Mô tả"
                           FontWeight="SemiBold" Margin="4"
                           Foreground="#263238"/>
                <TextBlock Grid.Column="2" Text="Loại giảm giá"
                           FontWeight="SemiBold" Margin="4"
                           Foreground="#263238"/>
                <TextBlock Grid.Column="3" Text="Giá trị giảm"
                           FontWeight="SemiBold" Margin="4"
                           Foreground="#263238"/>

                <TextBox x:Name="PromotionCodeTextBox"
                         Grid.Row="1"
                         Style="{StaticResource InputStyle}"/>
                <TextBox x:Name="DescriptionTextBox"
                         Grid.Row="1" Grid.Column="1"
                         Style="{StaticResource InputStyle}"/>
                <ComboBox x:Name="DiscountTypeComboBox"
                          Grid.Row="1" Grid.Column="2"
                          Height="34" Margin="4"
                          Padding="6"
                          VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Percent" IsSelected="True"/>
                    <ComboBoxItem Content="FixedAmount"/>
                </ComboBox>
                <TextBox x:Name="DiscountValueTextBox"
                         Grid.Row="1" Grid.Column="3"
                         Style="{StaticResource InputStyle}"/>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            Margin="0,10,0,0">
                    <StackPanel Width="180">
                        <TextBlock Text="Ngày bắt đầu"
                                   FontWeight="SemiBold" Margin="4"
                                   Foreground="#263238"/>
                        <DatePicker x:Name="StartDatePicker"
                                    Margin="4" Height="32"/>
                    </StackPanel>

                    <StackPanel Width="180">
                        <TextBlock Text="Ngày kết thúc"
                                   FontWeight="SemiBold" Margin="4"
                                   Foreground="#263238"/>
                        <DatePicker x:Name="EndDatePicker"
                                    Margin="4" Height="32"/>
                    </StackPanel>

                    <StackPanel Width="130">
                        <TextBlock Text="Số lượt tối đa"
                                   FontWeight="SemiBold" Margin="4"
                                   Foreground="#263238"/>
                        <TextBox x:Name="MaxUsageTextBox"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <CheckBox x:Name="IsActiveCheckBox"
                              Content="Đang hoạt động"
                              IsChecked="True"
                              VerticalAlignment="Bottom"
                              Margin="12,0,12,10"
                              Foreground="#263238"/>

                    <Button Content="Thêm mới"
                            Click="AddButton_Click"
                            Style="{StaticResource OrangeButton}"
                            VerticalAlignment="Bottom"/>

                    <Button Content="Cập nhật"
                            Click="UpdateButton_Click"
                            Style="{StaticResource BlueButton}"
                            VerticalAlignment="Bottom"/>

                    <Button Content="Xóa trắng"
                            Click="ClearButton_Click"
                            Style="{StaticResource BlueButton}"
                            VerticalAlignment="Bottom"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bảng khuyến mãi -->
        <Border Grid.Row="3" Background="White"
                BorderBrush="#E0E5EA" BorderThickness="1"
                CornerRadius="10" Padding="8">
            <DataGrid x:Name="PromotionsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionChanged="PromotionsGrid_SelectionChanged"
                      Background="White"
                      Foreground="#263238"
                      RowBackground="White"
                      AlternatingRowBackground="#FFF8F5F0"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding PromotionId}"
                                        Width="55"/>
                    <DataGridTextColumn Header="Mã khuyến mãi"
                                        Binding="{Binding PromotionCode}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Mô tả"
                                        Binding="{Binding Description}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Loại giảm"
                                        Binding="{Binding DiscountType}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Giá trị"
                                        Binding="{Binding DiscountValue}"
                                        Width="100"/>
                    <DataGridTextColumn Header="Bắt đầu (UTC)"
                                        Binding="{Binding StartAtUtc}"
                                        Width="145"/>
                    <DataGridTextColumn Header="Kết thúc (UTC)"
                                        Binding="{Binding EndAtUtc}"
                                        Width="145"/>
                    <DataGridTextColumn Header="Đã dùng"
                                        Binding="{Binding UsedCount}"
                                        Width="75"/>
                    <DataGridCheckBoxColumn Header="Hoạt động"
                                            Binding="{Binding IsActive}"
                                            Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="Chọn một dòng trong bảng để chỉnh sửa khuyến mãi."
                   Foreground="#718096" FontSize="12"
                   Margin="4,10,0,0"/>
    </Grid>
</Window>
