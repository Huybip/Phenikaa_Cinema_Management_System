<Window x:Class="PhenikaaCinema.Views.Admin.GenreManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PHENIKAA CINEMA | Quản lý thể loại phim"
        Height="680" Width="950"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#F4F8FC">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1769AA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#15324B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,7,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#D5E2EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Background="White" CornerRadius="12" Padding="18" BorderBrush="#E1EAF2" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Đóng" Style="{StaticResource ActionButton}"
                        Background="#64748B" Margin="12,0,0,0" VerticalAlignment="Center" Click="CloseButton_Click"/>
                <StackPanel>
                    <TextBlock Text="QUẢN LÝ THỂ LOẠI PHIM" FontSize="22" FontWeight="Bold" Foreground="#1769AA"/>
                    <TextBlock Text="Thêm, sửa, ngưng hoạt động hoặc xóa thể loại phim chiếu rạp" Foreground="#63778A" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- SEARCH / FILTER -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,14,0,14" BorderBrush="#E1EAF2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchTextBox" Height="36" VerticalAlignment="Center"
                         ToolTip="Tìm theo tên thể loại hoặc mô tả" TextChanged="SearchTextBox_TextChanged"/>
                <Button Grid.Column="1" Content="Làm mới" Style="{StaticResource ActionButton}"
                        Margin="10,0,0,0" Background="#64748B" Click="RefreshButton_Click"/>
            </Grid>
        </Border>

        <!-- CONTENT: LIST + FORM -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: DATA GRID -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0" BorderBrush="#E1EAF2" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Danh sách thể loại" FontSize="16" FontWeight="Bold" Foreground="#15324B" Margin="0,0,0,10"/>
                    <DataGrid x:Name="GenresDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                              Background="White" BorderThickness="0" SelectionChanged="GenresDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding GenreId}" Width="50"/>
                            <DataGridTextColumn Header="Tên thể loại" Binding="{Binding GenreName}" Width="140"/>
                            <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsActive}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- CỘT PHẢI: FORM CHỈNH SỬA -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18" BorderBrush="#E1EAF2" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Thông tin thể loại" FontSize="18" FontWeight="Bold" Foreground="#15324B" Margin="0,0,0,6"/>
                        <TextBlock Text="Chọn thể loại bên trái để chỉnh sửa hoặc nhập để thêm mới." Foreground="#63778A" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <TextBlock Text="Mã thể loại" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="GenreIdTextBox" IsReadOnly="True" Background="#F1F5F9" ToolTip="Tự sinh bởi hệ thống"/>

                        <TextBlock Text="Tên thể loại *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="GenreNameTextBox" MaxLength="100"/>

                        <TextBlock Text="Mô tả" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DescriptionTextBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>

                        <CheckBox x:Name="IsActiveCheckBox" Content="Đang hoạt động" IsChecked="True" FontSize="13" Margin="0,14,0,16"/>

                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Thêm thể loại" Style="{StaticResource ActionButton}" Background="#1769AA" Click="AddButton_Click"/>
                            <Button Content="Cập nhật" Style="{StaticResource ActionButton}" Background="#F58220" Click="UpdateButton_Click"/>
                            <Button Content="Xóa" Style="{StaticResource ActionButton}" Background="#C43D3D" Click="DeleteButton_Click"/>
                            <Button Content="Xóa trắng form" Style="{StaticResource ActionButton}" Background="#64748B" Click="ClearButton_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>

