<Window x:Class="PhenikaaCinema.Views.Admin.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mật khẩu tài khoản mới"
        Width="380" Height="230"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB">
    <StackPanel Margin="22">
        <TextBlock Text="Nhập mật khẩu cho tài khoản mới"
                   FontSize="16" FontWeight="Bold"
                   Foreground="#17365D" Margin="0,0,0,12"/>
        <PasswordBox x:Name="PasswordInput"
                     Height="36" Padding="8"/>
        <TextBlock Text="Mật khẩu tối thiểu 8 ký tự."
                   Foreground="#64748B" Margin="0,6,0,10"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Hủy" Width="80" Height="34"
                    Click="CancelButton_Click"/>
            <Button Content="Xác nhận" Width="100" Height="34"
                    Background="#E87524" Foreground="White"
                    Click="ConfirmButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
