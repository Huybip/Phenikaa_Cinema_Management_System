<Window x:Class="PhenikaaCinema.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PHENIKAA CINEMA | Hệ Thống Rạp Chiếu Phim Đẳng Cấp"
        Height="979"
        Width="1440"
        MinHeight="720"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER NAVIGATION ================= -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                Effect="{StaticResource CardShadow}">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- BRAND LOGO -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseDown="HomeMenuButton_Click">
                    <Border Width="46" Height="46" CornerRadius="10" Background="White" Margin="0,0,12,0" 
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="3">
                        <Image Source="/Assets/phenikaa_emblem.png" Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PHENIKAA"
                                       FontSize="20"
                                       FontWeight="ExtraBold"
                                       Foreground="{StaticResource DarkBlue}"/>
                            <TextBlock Text=" CINEMA"
                                       FontSize="20"
                                       FontWeight="ExtraBold"
                                       Foreground="{StaticResource AccentOrange}"/>
                        </StackPanel>
                        <TextBlock Text="ĐIỆN ẢNH ĐẲNG CẤP SINH VIÊN"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- TOP MENU LINKS -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Button Content="Trang chủ"
                            Style="{StaticResource GhostButton}"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBlue}"
                            Margin="0,0,6,0"
                            Click="HomeMenuButton_Click"/>

                    <Button Content="Phim đang chiếu"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,6,0"
                            Click="NowShowingButton_Click"/>

                    <Button Content="Phim sắp chiếu"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,6,0"
                            Click="ComingSoonButton_Click"/>

                    <Button Content="Về chúng tôi"
                            Style="{StaticResource GhostButton}"
                            Click="AboutButton_Click"/>
                </StackPanel>

                <!-- SEARCH & AUTH CONTROLS -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Search Input Box -->
                    <Border Background="#F1F5F9"
                            CornerRadius="8"
                            Height="40"
                            Width="240"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            Padding="10,0"
                            Margin="0,0,14,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" 
                                       FontFamily="Segoe MDL2 Assets" 
                                       FontSize="13" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,8,0"/>
                            <TextBox x:Name="SearchTextBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Foreground="{StaticResource TextMain}"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Nhập tên phim để tìm nhanh"
                                     TextChanged="SearchTextBox_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Login Button -->
                    <Button x:Name="LoginButton"
                            Content="Đăng nhập"
                            Style="{StaticResource PrimaryButton}"
                            Height="40"
                            Padding="20,0"
                            Click="OpenLoginButton_Click"/>

                    <!-- Logged In Panel -->
                    <StackPanel x:Name="LoggedInPanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <Border Background="{StaticResource LightBlue}" CornerRadius="20" Padding="14,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource DarkBlue}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TopUserName"
                                           Text="User"
                                           Foreground="{StaticResource DarkBlue}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Đăng xuất"
                                Style="{StaticResource DangerButton}"
                                Height="36"
                                Padding="12,0"
                                Click="LogoutButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT SCROLLVIEWER ================= -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ===== HERO BANNER SECTION ===== -->
                <Border Margin="32,24,32,0"
                        CornerRadius="16"
                        ClipToBounds="True"
                        Effect="{StaticResource CardShadow}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F172A" Offset="0.0"/>
                            <GradientStop Color="#1E3A8A" Offset="0.5"/>
                            <GradientStop Color="#1D4ED8" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid MinHeight="360" Margin="48,36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT TEXT & CALL-TO-ACTION -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <Border Background="#F97316" 
                                    CornerRadius="6" 
                                    Padding="10,4" 
                                    HorizontalAlignment="Left" 
                                    Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B2;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="PHENIKAA UNIVERSITY CINEMA" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="TRẢI NGHIỆM ĐIỆN ẢNH"
                                       Foreground="#93C5FD"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       />

                            <TextBlock Text="Thế Giới Điện Ảnh&#10;Đỉnh Cao &amp; Sống Động"
                                       Foreground="White"
                                       FontSize="40"
                                       FontWeight="ExtraBold"
                                       LineHeight="48"
                                       Margin="0,8,0,16"/>

                            <TextBlock Text="Hòa mình vào từng khoảnh khắc cảm xúc với màn chiếu Laser 4K, hệ thống âm thanh vòm Dolby Atmos và công nghệ sơ đồ phòng chiếu 2D/3D hiện đại."
                                       FontSize="14"
                                       Foreground="#E2E8F0"
                                       TextWrapping="Wrap"
                                       LineHeight="22"
                                       MaxWidth="560"
                                       Margin="0,0,0,28"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="🎬  ĐẶT VÉ NGAY"
                                        Style="{StaticResource AccentButton}"
                                        Height="46"
                                        Padding="28,0"
                                        FontSize="14"
                                        Click="NowShowingButton_Click"/>

                                <Button Content="KHÁM PHÁ THÊM  →"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="46"
                                        Padding="22,0"
                                        Margin="14,0,0,0"
                                        FontSize="14"
                                        Click="AboutButton_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- RIGHT HERO ILLUSTRATION / BRAND CARD -->
                        <Border Grid.Column="1" 
                                Background="#1E293B" 
                                CornerRadius="16" 
                                BorderBrush="#3B82F6" 
                                BorderThickness="1.5"
                                Padding="28"
                                VerticalAlignment="Center"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Logo on Card -->
                                <Border Grid.Row="0" Width="90" Height="90" CornerRadius="45" Background="White" Margin="0,0,0,16" HorizontalAlignment="Center" Effect="{StaticResource CardShadow}">
                                    <Image Source="/Assets/phenikaa_emblem.png" Stretch="Uniform" Margin="8"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,18">
                                    <TextBlock Text="PHENIKAA CINEMA" 
                                               Foreground="White" 
                                               FontSize="20" 
                                               FontWeight="ExtraBold" 
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rạp Chiếu Phim Đẳng Cấp Trường Phenikaa" 
                                               Foreground="#93C5FD" 
                                               FontSize="12" 
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" 
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <Border Grid.Row="2" Background="#0F172A" CornerRadius="12" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="4K" Foreground="{StaticResource AccentOrange}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Laser Screen" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="7.1" Foreground="#38BDF8" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Dolby Atmos" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="VIP" Foreground="#34D399" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Ghế Đôi Êm" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== FEATURE BADGES STRIP ===== -->
                <Grid Margin="32,24,32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="8" Background="{StaticResource LightBlue}" Margin="0,0,12,0">
                                <TextBlock Text="&#xE8B2;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Phim Bom Tấn Mới" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="Cập nhật liên tục mỗi tuần" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="8" Background="{StaticResource LightOrange}" Margin="0,0,12,0">
                                <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentOrange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Giá Vé Sinh Viên" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="Ưu đãi chỉ từ 45.000đ" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="8" Background="#DCFCE7" Margin="0,0,12,0">
                                <TextBlock Text="&#xE809;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Chọn Ghế 2D / 3D" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="Sơ đồ trực quan, tiện lợi" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource CardBorder}" Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="8" Background="#F1F5F9" Margin="0,0,12,0">
                                <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource DarkBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Vé Điện Tử QR Code" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="Vào rạp nhanh không cần xếp hàng" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== MOVIES SECTION HEADER & FILTERS ===== -->
                <StackPanel Margin="32,32,32,0">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="4" Height="26" CornerRadius="2" Background="{StaticResource PrimaryBlue}" Margin="0,0,10,0"/>
                                <TextBlock x:Name="MoviesHeading"
                                           Text="Phim Đang Chiếu Tại Rạp"
                                           FontSize="24"
                                           FontWeight="ExtraBold"
                                           Foreground="{StaticResource TextMain}"/>
                            </StackPanel>
                            <TextBlock x:Name="MoviesStatusText"
                                       Text="Đang tải danh sách phim từ hệ thống..."
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="14,4,0,0"/>
                        </StackPanel>

                        <!-- Filter buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Tất cả phim"
                                    Style="{StaticResource GhostButton}"
                                    FontWeight="SemiBold"
                                    Margin="0,0,6,0"
                                    Click="HomeMenuButton_Click"/>

                            <Button Content="Phim đang chiếu"
                                    Style="{StaticResource GhostButton}"
                                    FontWeight="SemiBold"
                                    Margin="0,0,6,0"
                                    Click="NowShowingButton_Click"/>

                            <Button Content="Làm mới  ↻"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="38"
                                    Padding="14,0"
                                    Click="LoadMovies_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- MOVIE CARDS WRAP CONTAINER -->
                    <ItemsControl x:Name="MoviesItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="240" Margin="0,0,0,20"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- ===== FOOTER SECTION ===== -->
                <Border Margin="0,48,0,0"
                        Background="{StaticResource DarkBlue}"
                        Padding="36,36">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Brand Info -->
                        <StackPanel Grid.Column="0" Margin="0,0,36,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                                <Border Width="40" Height="40" CornerRadius="8" Background="White" Margin="0,0,12,0" Padding="3">
                                    <Image Source="/Assets/phenikaa_emblem.png" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PHENIKAA CINEMA" Foreground="White" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="Trường Đại học Phenikaa" Foreground="#93C5FD" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Hệ thống rạp chiếu phim hiện đại phục vụ sinh viên và cán bộ giảng viên Trường Đại học Phenikaa. Mang lại những trải nghiệm nghệ thuật và giải trí tuyệt vời nhất."
                                       Foreground="#BFDBFE"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Contact & Address -->
                        <StackPanel Grid.Column="1" Margin="0,0,24,0">
                            <TextBlock Text="THÔNG TIN LIÊN HỆ" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,0,12"/>
                            <TextBlock Text="📍 Địa chỉ: Yên Nghĩa, Hà Đông, Hà Nội" Foreground="#BFDBFE" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="📞 Hotline: 024.6291.8118" Foreground="#BFDBFE" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="✉️ Email: cinema@phenikaa-uni.edu.vn" Foreground="#BFDBFE" FontSize="12"/>
                        </StackPanel>

                        <!-- Copyright -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <TextBlock Text="© 2026 PHENIKAA CINEMA" Foreground="White" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                            <TextBlock Text="All rights reserved • Developed with C# WPF" Foreground="#93C5FD" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
